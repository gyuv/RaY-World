# RaY-World environment configuration
#
# RaY-World uses TMDB as its primary metadata provider. Provide EITHER a v4
# access token (recommended) OR a v3 API key. If both are set, the v4 token wins.
#
# Get credentials at: https://www.themoviedb.org/settings/api

# v4 Read Access Token (Bearer). Recommended.
TMDB_ACCESS_TOKEN=

# v3 API key (fallback if no access token is set).
TMDB_API_KEY=

# Optional: override the TMDB API base URL.
# TMDB_API_BASE=https://api.themoviedb.org/3

# Optional: override the TMDB image CDN base URL.
# TMDB_IMAGE_BASE=https://image.tmdb.org/t/p
